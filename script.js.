
import { initializeApp } from "https://www.gstatic.com/firebasejs/12.6.0/firebase-app.js";

import {
  getAuth,
  createUserWithEmailAndPassword,
  signInWithEmailAndPassword,
  signOut
} from "https://www.gstatic.com/firebasejs/12.6.0/firebase-auth.js";

import {
  getDatabase,
  ref,
  set
} from "https://www.gstatic.com/firebasejs/12.6.0/firebase-database.js";

const firebaseConfig = {
  apiKey: "AIzaSyDelcahfeDjMPQ47c86qQV8JOQvIZ19Xtw",
  authDomain: "muachi-app.firebaseapp.com",
  projectId: "muachi-app",
  storageBucket: "muachi-app.firebasestorage.app",
  messagingSenderId: "137558594498",
  appId: "1:137558594498:web:f8b89350dc505e1e497c5b",
  measurementId: "G-PB24Y1HG2M"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);

const database = getDatabase(
  app,
  "https://muachi-app-default-rtdb.firebaseio.com/"
);

// CADASTRO DE UTILIZADORES
async function cadastrarUsuario(nome, email, senha, tipo) {
  try {
    const resultado = await createUserWithEmailAndPassword(
      auth,
      email,
      senha
    );

    await set(ref(database, "usuarios/" + resultado.user.uid), {
      nome: nome,
      email: email,
      tipo: tipo,
      dataCadastro: new Date().toISOString()
    });

    return "Cadastro realizado com sucesso!";
  } catch (erro) {
    console.error(erro);
    throw erro;
  }
}

// LOGIN
async function entrarUsuario(email, senha) {
  try {
    const resultado = await signInWithEmailAndPassword(
      auth,
      email,
      senha
    );

    return resultado.user;
  } catch (erro) {
    console.error(erro);
    throw erro;
  }
}

// TERMINAR SESSÃO
async function sairUsuario() {
  try {
    await signOut(auth);
    return "Sessão terminada com sucesso!";
  } catch (erro) {
    console.error(erro);
    throw erro;
  }
}

// DISPONIBILIZAR FUNÇÕES PARA A APLICAÇÃO
window.cadastrarUsuario = cadastrarUsuario;
window.entrarUsuario = entrarUsuario;
window.sairUsuario = sairUsuario;

console.log("MUACHI APP ligada ao Firebase!");
